---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import { about, values, stats } from '../data/site.js';
---
<Base title="About Us" description={about.mission}>
  <PageHero eyebrow={about.eyebrow} title="Who We Are" />

  <!-- Mission -->
  <section class="section section-cream">
    <div class="container center mission-block">
      <span class="eyebrow reveal">Our Mission</span>
      <p class="reveal mission-statement" data-delay="1">{about.mission}</p>
    </div>
  </section>

  <!-- Core values -->
  <section class="section section-cream-alt">
    <div class="container center">
      <span class="eyebrow reveal">Our Foundational Principles</span>
      <h2 class="reveal" data-delay="1">Our Core Values</h2>
    </div>
    <div class="container values-row">
      {values.map((v, i) => (
        <div class="value-block reveal" data-delay={i}>
          <span class="value-num">0{i + 1}</span>
          <h3>{v.title}</h3>
          <p>{v.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Our story -->
  <section class="section section-cream story">
    <div class="container story-grid">
      <div class="story-media reveal">
        <img src="/images/service-property-management.jpg" alt="An estate under our care" loading="lazy" />
      </div>
      <div class="story-text reveal" data-delay="1">
        <span class="eyebrow">Our Story</span>
        <h2 class="story-title">{about.storyTitle}</h2>
        {about.story.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <CTASection
    title="Experience the Difference"
    body="Discover what truly attentive, discreet estate care feels like. We would be honored to look after your property."
  />

  <style>
    .mission-block { max-width: 900px; margin-inline:auto; }
    .mission-statement {
      font-family: var(--font-serif);
      font-size: clamp(1.4rem, 1.1rem + 1.4vw, 2.2rem);
      line-height: 1.4;
      color: var(--charcoal);
      margin-top: 1.4rem;
      max-width: none;
    }
    .values-row { display:grid; grid-template-columns: repeat(4,1fr); gap: clamp(1.5rem,3vw,2.5rem); margin-top: clamp(2.5rem,5vw,3.5rem); }
    @media (max-width: 860px){ .values-row{ grid-template-columns: 1fr 1fr; } }
    @media (max-width: 460px){ .values-row{ grid-template-columns: 1fr; } }
    .value-block { border-top: 1px solid var(--hairline); padding-top: 1.3rem; }
    .value-num { font-family: var(--font-sans); font-size:0.8rem; letter-spacing:0.2em; color: var(--gold-deep); }
    .value-block h3 { margin: 0.7rem 0 0.8rem; }
    .value-block p { font-size: 0.92rem; color: var(--ink-soft); }

    .story-grid { display:grid; grid-template-columns: 1fr 1.1fr; gap: clamp(2rem,5vw,4.5rem); align-items:center; }
    @media (max-width: 820px){ .story-grid{ grid-template-columns:1fr; } }
    .story-media { aspect-ratio: 4/3; overflow:hidden; border-radius: var(--radius); }
    .story-media img { width:100%; height:100%; object-fit: cover; }
    .story-title { margin: 1rem 0 1.4rem; }
    .story-text p { color: var(--ink-soft); margin-bottom: 1.1rem; }
  </style>
</Base>
