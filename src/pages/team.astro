---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import { team } from '../data/site.js';
---
<Base title="Our Team" description="Meet the leadership behind The Estate Concierge Group.">
  <PageHero eyebrow="Our Team" title="The Leadership" />

  <section class="section section-cream">
    <div class="container center team-intro">
      <span class="eyebrow reveal">Meet the Visionaries</span>
      <p class="reveal mx-auto" data-delay="1">The dedicated professionals behind The Estate Concierge Group.</p>
    </div>

    <div class="container team-grid">
      {team.map((m, i) => (
        <article class="team-card reveal" data-delay={i}>
          <div class="team-photo">
            <img src={m.photo} alt={m.name} loading="lazy" />
          </div>
          <h3 class="team-name">{m.name}</h3>
          <span class="team-title">{m.title}</span>
          <p class="team-bio">{m.bio}</p>
        </article>
      ))}
    </div>
  </section>

  <CTASection
    title="Let's Care for Your Estate Together"
    body="Connect with our team for a private, complimentary consultation."
  />

  <style>
    .team-intro { max-width: 640px; margin-inline:auto; margin-bottom: clamp(2.5rem,5vw,4rem); }
    .team-intro p { color: var(--ink-soft); margin-top: 1rem; }
    .team-grid { display:grid; grid-template-columns: repeat(3,1fr); gap: clamp(1.5rem,3vw,2.75rem); }
    @media (max-width: 820px){ .team-grid{ grid-template-columns: 1fr; max-width: 460px; margin-inline:auto; } }
    .team-photo { aspect-ratio: 4/5; overflow:hidden; border-radius: var(--radius); margin-bottom: 1.4rem; }
    .team-photo img { width:100%; height:100%; object-fit: cover; transition: transform 0.9s var(--ease); }
    .team-card:hover .team-photo img { transform: scale(1.04); }
    .team-name { margin-bottom: 0.4rem; }
    .team-title { display:block; font-size:0.74rem; letter-spacing:0.18em; text-transform:uppercase; color: var(--gold-deep); margin-bottom: 1rem; }
    .team-bio { color: var(--ink-soft); font-size: 0.95rem; }
  </style>
</Base>
