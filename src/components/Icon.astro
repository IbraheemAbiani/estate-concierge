  tiktok: '<path d="M15.5 4c.3 1.9 1.4 3.2 3.5 3.4v2.4c-1.2.1-2.4-.3-3.5-1v4.9c0 3-2.2 5-4.9 4.6C8 20 6.4 18 6.5 15.7c.1-2.4 2.2-4.2 4.8-3.9v2.5c-.4-.1-.9-.2-1.3-.1-1 .1-1.7.9-1.7 1.9 0 1 .8 1.8 1.8 1.8s1.8-.8 1.8-1.9V4z"/>',
  arrowRight: '<path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  chevronLeft: '<path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  chevronRight: '<path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>',
  phone: '<path d="M6.6 3h3l1.5 4-2 1.3a11 11 0 004.6 4.6l1.3-2 4 1.5v3a1.5 1.5 0 01-1.6 1.5A16 16 0 015 4.6 1.5 1.5 0 016.6 3z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.5"/>',
  pin: '<path d="M12 21s-6-5.2-6-10a6 6 0 1112 0c0 4.8-6 10-6 10z" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="11" r="2.2" fill="none" stroke="currentColor" stroke-width="1.5"/>',
};
const inner = paths[name] || '';
const strokeIcons = ['arrowRight','chevronLeft','chevronRight','phone','mail','pin','instagram'];
const isStroke = strokeIcons.includes(name);
---
<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24"
     fill={isStroke ? 'none' : 'currentColor'} aria-hidden="true" set:html={inner}></svg>
