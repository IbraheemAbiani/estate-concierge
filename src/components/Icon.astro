---
// Minimal inline SVG icon set (social + UI). Keeps zero external requests.
const { name, size = 20 } = Astro.props;
const paths = {
  facebook: '<path d="M14 9h2V6h-2c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h2.1l.4-3H14V9.5c0-.3.2-.5.5-.5z"/>',
  instagram: '<rect x="4" y="4" width="16" height="16" rx="4.5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3.5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="16.6" cy="7.4" r="1.1"/>',
  youtube: '<path d="M21 8.4c-.2-1-.9-1.7-1.9-1.9C17.4 6.1 12 6.1 12 6.1s-5.4 0-7.1.4C3.9 6.7 3.2 7.4 3 8.4 2.6 10.1 2.6 12 2.6 12s0 1.9.4 3.6c.2 1 .9 1.7 1.9 1.9 1.7.4 7.1.4 7.1.4s5.4 0 7.1-.4c1-.2 1.7-.9 1.9-1.9.4-1.7.4-3.6.4-3.6s0-1.9-.4-3.6zM10.3 14.6V9.4l4.5 2.6z"/>',
  x: '<path d="M17.5 5h2.4l-5.3 6 6.2 8h-4.9l-3.8-5-4.4 5H5.3l5.6-6.4L4.7 5h5l3.4 4.6zm-.9 12.5h1.3L8.3 6.4H6.9z"/>',
