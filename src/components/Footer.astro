---
import { site, nav } from '../data/site.js';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
const exploreLinks = nav.filter((item) => item.label !== 'Home');
const [taglineStart, taglineEnd] = site.tagline.split(', ');
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <img src="/images/logo.png" alt={site.name} width="72" height="72" />
        <p class="footer-tagline">{taglineStart}, <br />{taglineEnd}</p>
      </div>

      <nav class="footer-nav" aria-label="Footer">
        <span class="footer-heading">Explore</span>
        {exploreLinks.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <div class="footer-contact">
        <span class="footer-heading">Contact</span>
        <a href={site.phoneHref}>{site.phone}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <p>{site.address.line1}<br />{site.address.line2}</p>
      </div>
    </div>

    <hr class="rule footer-rule" />

    <div class="footer-bottom">
      <p class="footer-copy">© {year} {site.name}. All rights reserved.</p>
      <div class="footer-socials">
        {site.socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.icon} size={18} /></a>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--charcoal);
    color: var(--on-dark-soft);
    padding-block: clamp(2.5rem, 4vw, 3.5rem) 1.6rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
  }
  @media (max-width: 820px) { .footer-grid { grid-template-columns: 1fr 1fr; row-gap: 2.2rem; } }
  @media (max-width: 540px) { .footer-grid { grid-template-columns: 1fr; text-align: center; } }

  .footer-brand img { width: 60px; height: 60px; object-fit: contain; }
  @media (max-width: 540px) { .footer-brand img { margin-inline: auto; } }
  .footer-tagline {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-style: italic;
    color: var(--on-dark);
    margin-top: 0.8rem;
    max-width: 22ch;
  }
  @media (max-width: 540px) { .footer-tagline { margin-inline: auto; } }

  .footer-heading {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-light);
    margin-bottom: 0.7rem;
  }
  .footer-nav, .footer-contact { display: flex; flex-direction: column; gap: 0.45rem; }
  .footer-nav a, .footer-contact a {
    color: var(--on-dark-soft);
    font-size: 0.92rem;
    transition: color 0.3s var(--ease);
    width: fit-content;
  }
  @media (max-width: 540px) { .footer-nav a, .footer-contact a { margin-inline: auto; } }
  .footer-nav a:hover, .footer-contact a:hover { color: var(--gold-light); }
  .footer-contact p { color: var(--on-dark-soft); font-size: 0.92rem; line-height: 1.6; margin-top: 0.1rem; }

  .footer-rule { margin-block: 1.8rem 1.3rem; background: rgba(255,255,255,0.12); }

  .footer-bottom {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 1rem;
  }
  @media (max-width: 540px) { .footer-bottom { justify-content: center; text-align: center; } }
  .footer-copy { font-size: 0.82rem; letter-spacing: 0.04em; color: rgba(255,255,255,0.5); }
  .footer-socials { display: flex; gap: 1.1rem; }
  .footer-socials a { color: rgba(255,255,255,0.6); transition: color 0.3s var(--ease); }
  .footer-socials a:hover { color: var(--gold-light); }
</style>
