---
import { showcase } from '../data/site.js';
import Icon from './Icon.astro';
const { items = showcase, eyebrow = "Portfolio", title = "A Glimpse of the Estates We Care For" } = Astro.props;
---
<section class="section section-cream vc-section">
  <div class="container center vc-head">
    <span class="eyebrow reveal">{eyebrow}</span>
    <h2 class="reveal" data-delay="1">{title}</h2>
  </div>

  <div class="vc" data-carousel>
    <button class="vc-arrow vc-arrow--prev" data-vc-prev aria-label="Previous">
      <Icon name="chevronLeft" size={26} />
    </button>

    <div class="vc-stage">
      {items.map((item, i) => (
        <figure class="vc-slide" data-index={i}>
          <div class="vc-media">
            {item.src ? (
              <video src={item.src} poster={item.poster} muted loop playsinline preload="metadata"></video>
            ) : (
              <img src={item.poster} alt={item.title} loading="lazy" />
            )}
            <span class="vc-scrim"></span>
            <figcaption class="vc-caption">{item.title}</figcaption>
          </div>
        </figure>
      ))}
    </div>

    <button class="vc-arrow vc-arrow--next" data-vc-next aria-label="Next">
      <Icon name="chevronRight" size={26} />
    </button>
  </div>

  <div class="vc-dots" data-vc-dots role="tablist" aria-label="Choose slide">
    {items.map((_, i) => (
      <button class="vc-dot" data-vc-dot={i} aria-label={`Go to slide ${i + 1}`}></button>
    ))}
  </div>
</section>

<style>
  .vc-section { overflow: hidden; }
  .vc-head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }

  .vc {
    position: relative;
    width: 100%;
    max-width: var(--container-wide);
    margin-inline: auto;
    height: clamp(320px, 46vw, 620px);
  }
  .vc-stage { position: absolute; inset: 0; }

  .vc-slide {
    position: absolute;
    top: 50%; left: 50%;
    width: min(64%, 900px);
    aspect-ratio: 16 / 10;
    margin: 0;
    transform: translate(-50%, -50%);
    transition: transform 0.7s var(--ease), opacity 0.7s var(--ease);
    opacity: 0;
    will-change: transform, opacity;
  }
  @media (max-width: 720px) { .vc-slide { width: 80%; } }

  .vc-media {
    position: relative;
    width: 100%; height: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--charcoal);
    box-shadow: 0 30px 70px rgba(34,39,46,0.28);
  }
  .vc-media video, .vc-media img {
    width: 100%; height: 100%; object-fit: cover;
  }
  .vc-scrim {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(20,23,28,0.62) 0%, transparent 45%);
  }
  .vc-caption {
    position: absolute; left: clamp(1.2rem, 2.5vw, 2.2rem); bottom: clamp(1.1rem, 2.5vw, 1.8rem);
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    color: #fff;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s var(--ease) 0.15s, transform 0.5s var(--ease) 0.15s;
  }
  .vc-slide.is-active .vc-caption { opacity: 1; transform: none; }
  .vc-slide.is-active .vc-media { outline: 1px solid rgba(191,159,94,0.5); outline-offset: 6px; }

  .vc-arrow {
    position: absolute; top: 50%; transform: translateY(-50%);
    z-index: 30;
    width: clamp(46px, 4vw, 60px); height: clamp(46px, 4vw, 60px);
    border-radius: 50%;
    background: rgba(255,255,255,0.9);
    color: var(--charcoal);
    display: grid; place-items: center;
    box-shadow: 0 8px 26px rgba(34,39,46,0.18);
    transition: background 0.3s var(--ease), color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .vc-arrow:hover { background: var(--gold); color: #fff; }
  .vc-arrow--prev { left: clamp(0.5rem, 4vw, 4rem); }
  .vc-arrow--next { right: clamp(0.5rem, 4vw, 4rem); }
  .vc-arrow:hover.vc-arrow--prev { transform: translateY(-50%) translateX(-3px); }
  .vc-arrow:hover.vc-arrow--next { transform: translateY(-50%) translateX(3px); }

  .vc-dots { display: flex; justify-content: center; gap: 0.7rem; margin-top: clamp(2rem, 4vw, 3rem); }
  .vc-dot {
    width: 9px; height: 9px; border-radius: 50%;
    background: rgba(34,39,46,0.2);
    transition: background 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .vc-dot.is-active { background: var(--gold); transform: scale(1.3); }
</style>

<script>
  document.querySelectorAll('[data-carousel]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll('.vc-slide'));
    const n = slides.length;
    if (!n) return;
    const section = root.closest('.vc-section');
    const dots = Array.from(section.querySelectorAll('[data-vc-dot]'));
    const prevBtn = root.querySelector('[data-vc-prev]');
    const nextBtn = root.querySelector('[data-vc-next]');
    let active = 0;
    let timer = null;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function layout() {
      const mobile = window.innerWidth < 720;
      const peek = mobile ? 108 : 62;      // % of slide width the neighbours are pushed aside
      const sideScale = mobile ? 0.9 : 0.82;
      const sideOpacity = mobile ? 0 : 0.5;

      slides.forEach((s, i) => {
        let d = i - active;
        if (d > n / 2) d -= n;
        if (d < -n / 2) d += n;
        const abs = Math.abs(d);
        const isCenter = d === 0;
        const visible = abs <= (mobile ? 0.5 : 1.5);
        const tx = d * peek;
        const scale = isCenter ? 1 : sideScale;
        s.style.transform = `translate(-50%, -50%) translateX(${tx}%) scale(${scale})`;
        s.style.opacity = visible ? (isCenter ? 1 : sideOpacity) : 0;
        s.style.zIndex = String(20 - abs);
        s.style.pointerEvents = isCenter ? 'auto' : 'none';
        s.classList.toggle('is-active', isCenter);

        const v = s.querySelector('video');
        if (v) {
          if (isCenter) { const p = v.play(); if (p) p.catch(() => {}); }
          else { v.pause(); }
        }
      });
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === active));
    }

    const go = (i) => { active = (i + n) % n; layout(); };
    const next = () => go(active + 1);
    const prev = () => go(active - 1);

    nextBtn?.addEventListener('click', () => { next(); restart(); });
    prevBtn?.addEventListener('click', () => { prev(); restart(); });
    dots.forEach((dot, i) => dot.addEventListener('click', () => { go(i); restart(); }));

    // Click a side slide to bring it to center
    slides.forEach((s, i) => s.addEventListener('click', () => { if (i !== active) { go(i); restart(); } }));

    function start() { if (!reduce) timer = setInterval(next, 6000); }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    function restart() { stop(); start(); }

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    let resizeRaf;
    window.addEventListener('resize', () => { cancelAnimationFrame(resizeRaf); resizeRaf = requestAnimationFrame(layout); });

    layout();
    start();
  });
</script>
