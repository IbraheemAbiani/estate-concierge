---
const { eyebrow, title, intro } = Astro.props;
---
<section class="page-hero section-dark">
  <div class="container center">
    {eyebrow && <span class="eyebrow reveal">{eyebrow}</span>}
    <h1 class="page-hero-title reveal" data-delay="1">{title}</h1>
    {intro && <p class="page-hero-intro reveal mx-auto" data-delay="2">{intro}</p>}
  </div>
</section>

<style>
  .page-hero {
    padding-top: calc(var(--header-h) + clamp(3rem, 8vw, 7rem));
    padding-bottom: clamp(3.5rem, 8vw, 7rem);
    position: relative;
    overflow: hidden;
  }
  .page-hero::after {
    content: "";
    position: absolute; inset: 0;
    background: radial-gradient(120% 90% at 70% 120%, rgba(191,159,94,0.14), transparent 60%);
    pointer-events: none;
  }
  .page-hero-title { margin-top: 1.2rem; }
  .page-hero-intro {
    margin-top: 1.6rem;
    max-width: 60ch;
    color: var(--on-dark-soft);
    font-size: 1.1rem;
  }
</style>
